# Copy to .env and fill in. Never commit .env — it is gitignored.

# NeonDB / PostgreSQL connection string
# Get this from your NeonDB console (use the pooled connection string)
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Public base URL for API calls (exposed to the client via runtimeConfig.public)
NUXT_PUBLIC_API_BASE=/api
